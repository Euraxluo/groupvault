NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_GROUPVAULT_CONTRACT=
NEXT_PUBLIC_JOIN_FT=
NEXT_PUBLIC_FACTORY=sputnikv2.testnet
NEXT_PUBLIC_INDEXER_URL=http://127.0.0.1:8787

# Demo / Playwright keypair signing (testnet only). Never commit real secrets.
# Prefer exporting these in the shell for e2e; .env.local is gitignored.
# DEMO_ACCOUNT_A=gv-a-….testnet
# DEMO_ACCOUNT_B=gv-b-….testnet
# DEMO_PRIVATE_KEY_A=ed25519:…
# DEMO_PRIVATE_KEY_B=ed25519:…
# Or a single account:
# DEMO_ACCOUNT_ID=gv-a-….testnet
# DEMO_PRIVATE_KEY=ed25519:…
# DEMO_KEYPAIR_MODE=1
